{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScreeningInput integration contract",
  "type": "object",
  "properties": {
    "site": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "province": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "district": {
          "type": "string"
        },
        "source_record_id": {
          "type": "string"
        },
        "source_record_confirmed": {
          "type": "boolean"
        }
      }
    },
    "ai_geometry": {
      "type": "object",
      "required": [
        "height_m",
        "tilt_deg",
        "terrain"
      ],
      "properties": {
        "height_m": {
          "type": "object",
          "required": [
            "min",
            "max",
            "source"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tilt_deg": {
          "type": "object",
          "required": [
            "min",
            "max",
            "source"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "terrain": {
          "type": "object",
          "required": [
            "candidates",
            "source"
          ],
          "properties": {
            "candidates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              }
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "snow_conditions": {
      "type": "object",
      "properties": {
        "special_accumulation_flag": {
          "type": "boolean"
        }
      }
    }
  }
}
